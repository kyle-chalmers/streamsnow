{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config --frozen --offline --no-python-downloads --quiet \"${CLAUDE_PLUGIN_ROOT}/hooks/deploy_safety.py\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config --frozen --offline --no-python-downloads --quiet \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_guard.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config --frozen --offline --no-python-downloads --quiet \"${CLAUDE_PLUGIN_ROOT}/hooks/review_gate_stop.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
