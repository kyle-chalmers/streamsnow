# Warehouse-runtime dependencies (Snowflake Anaconda channel).
# LANDMINE: never pin `python` here — the channel has no exact python==3.11
# build, so the deploy fails. The runtime supplies Python; list only added deps.
#
# The Streamlit pin selects the version Snowflake runs for this app. Warehouse
# runtimes support only a fixed list of versions (Snowflake docs, "Supported
# versions of the Streamlit library in warehouse runtimes"), so never track the
# container pin here or the deploy fails. The newest supported version still has
# two known CVEs; the repo's osv_allowlist.json records why they are accepted
# and when to re-check.
name: sf_env
channels:
  - snowflake
dependencies:
  - streamlit={{ warehouse_streamlit_pin }}
  - pandas
  - plotly
  - snowflake-snowpark-python
