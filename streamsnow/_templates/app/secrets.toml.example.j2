# OPTIONAL per-app override for local preview. Most developers never need this
# file: st.connection("snowflake") reads the default connection you created with
#   snow connection add --connection-name {{ connection_name }} ... --default
# (the snow CLI's connections.toml, shared by every Snowflake tool). Copy this to
# secrets.toml (gitignored, NEVER committed) only when this app needs a
# different role/warehouse than that default.
#
# Never put a password here: Snowflake's MFA rollout (account-specific, through
# 2026) ends password-only sign-in, and a plaintext password in a dotfile is the
# wrong shape regardless. SSO via externalbrowser (below) or a programmatic
# access token is the path. `account` is the LOCATOR, not the
# *.snowflakecomputing.com host — the connector appends the suffix and a doubled
# one fails auth. `role` defaults to the VIEWER role, which is narrower than a
# personal role. The deployed app reads with the CI (owner) role's grants, and
# `deploy-setup --admin` gives the viewer role no data grants by default: for
# local preview, uncomment its opt-in viewer data grants, or set `role` to a
# role whose reads match the CI role's.
[connections.snowflake]
account = "{{ account }}"
user = "<your_username>"
authenticator = "externalbrowser"
role = "{{ viewer_role }}"
warehouse = "{{ default_warehouse }}"
database = "{{ gov_database }}"
schema = "{{ schema_allow[0] }}"
