"""{{ app_title }} — entrypoint. Scaffolded by StreamSnow ({{ runtime }} runtime)."""

import streamlit as st
from branding import apply_branding

# Deployed in Snowflake, page_title/page_icon are ignored (Snowsight owns the
# tab); they still apply under `streamlit run`. `layout` applies in both.
# Importing branding makes no st.* call, so set_page_config is still the first
# Streamlit command; apply_branding() must run after it.
st.set_page_config(page_title="{{ app_title }}", page_icon="📊", layout="wide")
apply_branding()

# Until st.navigation runs, Streamlit shows its fallback menu: every file under pages/,
# underscore helpers included. Keep that window short. No data call or widget may run
# before st.navigation. Put filters after `nav`, or inside the pages, so they do not stretch it.
nav = st.navigation(
    [
        st.Page("pages/overview.py", title="Overview", icon="📈", default=True),
        st.Page("pages/about.py", title="About", icon=":material/info:"),
    ]
)
nav.run()
