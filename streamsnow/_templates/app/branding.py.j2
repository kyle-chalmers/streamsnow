"""Branding for {{ project_name }} — generated by StreamSnow from brand config.

Each app ships its own local copy (deploy runtimes can't import a shared module).
Import locally: ``from branding import apply_branding, branded_metric``.
"""

import plotly.graph_objects as go
import plotly.io as pio
import streamlit as st

_BRANDING_VERSION = "1.3.0"

BRAND_COLORS = {
    "primary": "{{ brand.primary }}",
    "background": "{{ brand.background }}",
    "text": "{{ brand.text_color }}",
}
BRAND_CHART_COLORS = [{{ brand.chart_sequence | map('tojson') | join(", ") }}]
# Status hues mean good / warning / bad and stay out of ordinary series
# (skills/_shared/visualization-guide.md). Pair them with a label or icon.
BRAND_STATUS_COLORS = {"good": "#008300", "warning": "#C98500", "bad": "#E34948"}

# Register the Plotly template once. Guard against re-registration AND the
# default-set side effect: the container runtime shares one Python process
# across all viewers, so module-import mutations must be idempotent.
# Inside st.plotly_chart only "colorway" shows: Streamlit replaces the font and
# backgrounds with the .streamlit/config.toml theme. The rest serves exports.
if "streamsnow_brand" not in pio.templates:
    pio.templates["streamsnow_brand"] = go.layout.Template(
        layout={
            "font": {"family": "{{ brand.font }}", "color": "{{ brand.text_color }}"},
            "colorway": BRAND_CHART_COLORS,
            "paper_bgcolor": "{{ brand.background }}",
            "plot_bgcolor": "{{ brand.background }}",
        }
    )
    pio.templates.default = "streamsnow_brand"
BRAND_PLOTLY_TEMPLATE = "streamsnow_brand"


def apply_branding() -> None:
    """Call once, right after ``st.set_page_config``. Sets the Plotly default."""
    pio.templates.default = "streamsnow_brand"


_UNITS = ((1, ""), (1e3, "k"), (1e6, "M"), (1e9, "B"))


def fmt_number(x: float, decimals: int = 1) -> str:
    """Compact number for cards and labels: 950, 12.3k, 4.5M, 1.2B. Counts stay integers."""
    n = abs(x)
    # Pick the unit after rounding, so 999_999 reads "1.0M", never "1000.0k".
    unit = 0
    while unit < len(_UNITS) - 1 and round(n / _UNITS[unit][0], decimals) >= 1000:
        unit += 1
    limit, suffix = _UNITS[unit]
    if unit == 0:
        text = f"{n:,.0f}" if float(n).is_integer() else f"{n:,.{decimals}f}"
    else:
        text = f"{n / limit:.{decimals}f}{suffix}"
    # The sign follows the rounded text: -0.04 reads "0.0", never "-0.0".
    return f"-{text}" if x < 0 and any(c in "123456789" for c in text) else text


def fmt_currency(x: float, symbol: str = "$", decimals: int = 1) -> str:
    """Compact currency in the house symbol: $48.6k, -$1.2M."""
    text = fmt_number(x, decimals)
    return f"-{symbol}{text[1:]}" if text.startswith("-") else f"{symbol}{text}"


def fmt_pct(ratio: float, decimals: int = 1) -> str:
    """A ratio as a percentage: 0.345 -> 34.5%."""
    return f"{ratio * 100:.{decimals}f}%"


# A falling delta starts with: hyphen, minus sign, down arrow, down triangle, or "(".
_DOWN_MARKS = ("-", "\u2212", "\u2193", "\u25bc", "(")


def _metric_delta(delta: str, delta_color: str = "normal") -> tuple[str, str]:
    """The ``(delta_color, delta_arrow)`` that make ``st.metric`` show a delta by meaning.

    ``st.metric`` reads direction only from a leading hyphen, so "(5%)", "\u2193 5%" and a
    minus sign would show as a green rise. Read the direction here instead, set the arrow
    from it, and flip "normal"/"inverse" where Streamlit would misread the sign. A delta
    with no non-zero digit ("0%", "+0.0 pts") is no change: grey, with no arrow.
    """
    if not any(c in "123456789" for c in delta):
        return "off", "off"
    down = delta.lstrip().startswith(_DOWN_MARKS)
    arrow = "down" if down else "up"
    if delta_color == "off":
        return "off", arrow
    streamlit_sees_down = delta.lstrip().startswith("-")
    if down != streamlit_sees_down:
        delta_color = "inverse" if delta_color == "normal" else "normal"
    return delta_color, arrow


def branded_metric(
    label: str,
    value: str,
    delta: str | None = None,
    border_color: str | None = None,
    help: str | None = None,
    delta_color: str = "normal",
    *,
    chart_data=None,
    chart_type: str = "line",
) -> None:
    """A bordered metric card: ``st.metric`` with the house delta rules.

    ``help`` is the metric's definition (from ``pages/_glossary.py``), shown as the card's
    hover tooltip. ``delta_color`` colors the delta by meaning: "normal" (up is good),
    "inverse" (up is bad, e.g. cost) or "off"; the direction is read from the delta's
    leading sign, arrow or parentheses (``_metric_delta``). Needs Streamlit 1.52 or later
    (``delta_arrow``).

    ``chart_data`` (a list or Series of recent values) draws the card's sparkline, as a
    "line", "bar" or "area" ``chart_type``. Only arguments ``st.metric`` takes on both
    pinned runtimes (warehouse 1.52.2, container 1.59.2) pass through; ``format`` and
    ``delta_description`` are 1.59-only and would fail a warehouse app.

    ``border_color`` is accepted so older calls keep working but has no effect: the border
    is ``st.metric``'s own. Until 1.2.0 this card was raw HTML with a brand-colored left
    border, and an HTML hover attribute shows no tooltip in Streamlit, so every KPI
    definition was invisible.
    """
    del border_color  # kept for positional compatibility, see docstring
    color, arrow = _metric_delta(delta, delta_color) if delta else (delta_color, "auto")
    st.metric(
        label,
        value,
        delta=delta,
        delta_color=color,
        delta_arrow=arrow,
        help=help,
        border=True,
        chart_data=chart_data,
        chart_type=chart_type,
    )
