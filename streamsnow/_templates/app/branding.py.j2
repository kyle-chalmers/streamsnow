"""Branding for {{ project_name }} — generated by StreamSnow from brand config.

Each app ships its own local copy (deploy runtimes can't import a shared module).
Import locally: ``from branding import apply_branding, branded_metric``.
"""

import html

import plotly.graph_objects as go
import plotly.io as pio
import streamlit as st

_BRANDING_VERSION = "1.1.0"

BRAND_COLORS = {
    "primary": "{{ brand.primary }}",
    "background": "{{ brand.background }}",
    "text": "{{ brand.text_color }}",
}
BRAND_CHART_COLORS = [{{ brand.chart_sequence | map('tojson') | join(", ") }}]
# Status hues mean good / warning / bad and stay out of ordinary series
# (skills/_shared/visualization-guide.md). Pair them with a label or icon.
BRAND_STATUS_COLORS = {"good": "#008300", "warning": "#C98500", "bad": "#E34948"}

# Register the Plotly template once. Guard against re-registration AND the
# default-set side effect: the container runtime shares one Python process
# across all viewers, so module-import mutations must be idempotent.
if "streamsnow_brand" not in pio.templates:
    pio.templates["streamsnow_brand"] = go.layout.Template(
        layout={
            "font": {"family": "{{ brand.font }}", "color": "{{ brand.text_color }}"},
            "colorway": BRAND_CHART_COLORS,
            "paper_bgcolor": "{{ brand.background }}",
            "plot_bgcolor": "{{ brand.background }}",
        }
    )
    pio.templates.default = "streamsnow_brand"
BRAND_PLOTLY_TEMPLATE = "streamsnow_brand"


def apply_branding() -> None:
    """Call once, right after ``st.set_page_config``. Sets the Plotly default."""
    pio.templates.default = "streamsnow_brand"


_UNITS = ((1, ""), (1e3, "k"), (1e6, "M"), (1e9, "B"))


def fmt_number(x: float, decimals: int = 1) -> str:
    """Compact number for cards and labels: 950, 12.3k, 4.5M, 1.2B. Counts stay integers."""
    n = abs(x)
    # Pick the unit after rounding, so 999_999 reads "1.0M", never "1000.0k".
    unit = 0
    while unit < len(_UNITS) - 1 and round(n / _UNITS[unit][0], decimals) >= 1000:
        unit += 1
    limit, suffix = _UNITS[unit]
    if unit == 0:
        text = f"{n:,.0f}" if float(n).is_integer() else f"{n:,.{decimals}f}"
    else:
        text = f"{n / limit:.{decimals}f}{suffix}"
    # The sign follows the rounded text: -0.04 reads "0.0", never "-0.0".
    return f"-{text}" if x < 0 and any(c in "123456789" for c in text) else text


def fmt_currency(x: float, symbol: str = "$", decimals: int = 1) -> str:
    """Compact currency in the house symbol: $48.6k, -$1.2M."""
    text = fmt_number(x, decimals)
    return f"-{symbol}{text[1:]}" if text.startswith("-") else f"{symbol}{text}"


def fmt_pct(ratio: float, decimals: int = 1) -> str:
    """A ratio as a percentage: 0.345 -> 34.5%."""
    return f"{ratio * 100:.{decimals}f}%"


_DELTA_COLORS = {"up": BRAND_STATUS_COLORS["good"], "down": BRAND_STATUS_COLORS["bad"]}
_NEUTRAL_INK = "#6b7280"


def _delta_ink(delta: str, delta_color: str = "normal") -> str:
    """The delta's color by meaning: up is good ("normal"), up is bad ("inverse"), or
    grey ("off"). A delta with no non-zero digit ("0%", "+0.0 pts") is no change: grey."""
    if delta_color == "off" or not any(c in "123456789" for c in delta):
        return _NEUTRAL_INK
    down = delta.lstrip().startswith(("-", "\u2212"))
    if delta_color == "inverse":
        down = not down
    return _DELTA_COLORS["down" if down else "up"]


def branded_metric(
    label: str,
    value: str,
    delta: str | None = None,
    border_color: str | None = None,
    help: str | None = None,
    delta_color: str = "normal",
) -> None:
    """A metric card with a brand-colored left border.

    ``help`` is the metric's definition (from ``pages/_glossary.py``), shown as a
    hover tooltip like ``st.metric(help=...)``. ``delta_color`` colors the delta by
    meaning, as ``st.metric`` does: "normal" (up is good), "inverse" (up is bad,
    e.g. cost) or "off". The direction is read from the delta's leading sign.

    label/value/delta/help/border_color are HTML-escaped before interpolation —
    the card uses unsafe_allow_html=True, so escaping stops a database-derived
    value (including a per-tenant brand color) from breaking out of the
    attribute and injecting markup into the viewer's page.
    """
    color = html.escape(border_color or BRAND_COLORS["primary"])
    label, value = html.escape(label), html.escape(value)
    help_html = (
        f' <span title="{html.escape(help)}" aria-label="{html.escape(help)}"'
        ' style="cursor:help;">&#9432;</span>'
        if help
        else ""
    )
    delta_html = ""
    if delta:
        delta_ink = _delta_ink(delta, delta_color)
        delta_html = f'<div style="font-size:0.8rem;color:{delta_ink};">{html.escape(delta)}</div>'
    st.markdown(
        f'<div style="border-left:4px solid {color};padding:0.25rem 0.75rem;margin:0.25rem 0;">'
        f'<div style="font-size:0.8rem;color:#6b7280;">{label}{help_html}</div>'
        f'<div style="font-size:1.6rem;font-weight:600;">{value}</div>'
        f"{delta_html}</div>",
        unsafe_allow_html=True,
    )
