# Governance checks for {{ project_name }} (generated by StreamSnow).
# Runs the same guardrails as the local pre-commit hooks. The deploy workflow
# is wired separately when you connect your Snowflake CI credentials.
name: checks

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: checks-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

jobs:
  checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Full history: the tombstones check diffs against origin/main.
          fetch-depth: 0
      - uses: astral-sh/setup-uv@v5
      - name: Install tooling
        run: |
          # Same ruff as the pre-commit hook: an unpinned install tracks ruff's
          # default rule set, which changes between releases.
          uv tool install ruff=={{ ruff_version }}
          uv tool install 'streamsnow>=0.13.0,<0.14'
      - name: Lint
        run: |
          # A repo with no app yet (`streamsnow init --no-starter-app`) has no apps/
          # directory: git cannot carry an empty one, and ruff errors on a missing path.
          if [ -d apps ]; then ruff check apps/; else echo "No apps/ yet: nothing to lint."; fi
      - name: Governance gate (validate every app)
        run: |
          for d in apps/*/; do
            [ -d "$d" ] || continue
            streamsnow validate-app "$(basename "$d")"
          done
      # Fail-closed for every EXACT pin (==). Range pins are reported unscanned
      # by design — the scaffold deliberately leaves e.g. snowflake-snowpark-python
      # range-pinned so uv resolves it. Stricter shops: add --strict-pins here
      # AND pin every dependency exactly.
      - name: Dependency vulnerabilities (OSV — exact pins, fail-closed)
        run: streamsnow check dependency-vulns
      - name: SQL-review audit trail (fresh + complete)
        run: streamsnow sql-review check
      - name: Tombstones (no abandoned deployed objects)
        run: |
          # The check refuses a missing apps/ on purpose (an unseen apps dir must never
          # read as "no apps"). Skip it only when apps/ is absent here AND on the base
          # branch: nothing has been deployed from this repo, so nothing can be abandoned.
          if [ ! -d apps ] && [ -z "$(git ls-tree -d origin/main apps 2>/dev/null)" ]; then
            echo "No apps/ here or on origin/main yet: nothing to tombstone."
          else
            streamsnow check tombstones --base-ref origin/main
          fi
