{% raw %}# Deploy to Snowflake on merge to main (generated by StreamSnow — stage-copy).
# Set these repo secrets first (https://github.com/kyle-chalmers/streamsnow/blob/main/docs/deploy-setup.md). Until SNOWFLAKE_ACCOUNT is
# set the job SKIPS, so it never red-X's a normal merge:
#   SNOWFLAKE_ACCOUNT  SNOWFLAKE_USER  SNOWFLAKE_PRIVATE_KEY_RAW
#   SNOWFLAKE_PRIVATE_KEY_PASSPHRASE (optional)  SNOWFLAKE_WAREHOUSE  SNOWFLAKE_ROLE
name: deploy

on:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: deploy-snowflake
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      SNOWFLAKE_ACCOUNT: ${{ secrets.SNOWFLAKE_ACCOUNT }}
      SNOWFLAKE_USER: ${{ secrets.SNOWFLAKE_USER }}
      SNOWFLAKE_AUTHENTICATOR: SNOWFLAKE_JWT
      SNOWFLAKE_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_PRIVATE_KEY_RAW }}
      # snow reads an encrypted key's passphrase from PRIVATE_KEY_PASSPHRASE
      # (no SNOWFLAKE_ prefix); unused when the key is unencrypted.
      PRIVATE_KEY_PASSPHRASE: ${{ secrets.SNOWFLAKE_PRIVATE_KEY_PASSPHRASE }}
      SNOWFLAKE_WAREHOUSE: ${{ secrets.SNOWFLAKE_WAREHOUSE }}
      SNOWFLAKE_ROLE: ${{ secrets.SNOWFLAKE_ROLE }}
    # Every snow call (and verify-deploy) passes --temporary-connection: the
    # runner has no config.toml, so without it the Snowflake CLI looks for a
    # connection named "default" and fails ("Connection default is not
    # configured") instead of connecting from the SNOWFLAKE_* variables above
    # (https://docs.snowflake.com/en/developer-guide/snowflake-cli/connecting/configure-connections#use-a-temporary-connection).
    steps:
      - uses: actions/checkout@v4

      - name: Gate on configured secrets
        id: gate
        run: |
          if [ -z "$SNOWFLAKE_ACCOUNT" ]; then
            echo "Deploy secrets not set — skipping (see https://github.com/kyle-chalmers/streamsnow/blob/main/docs/deploy-setup.md)."
            echo "go=false" >> "$GITHUB_OUTPUT"
          else
            echo "Deploy secrets found: deploying."
            echo "go=true" >> "$GITHUB_OUTPUT"
          fi

      - uses: astral-sh/setup-uv@v5
        if: steps.gate.outputs.go == 'true'

      - name: Install tooling
        if: steps.gate.outputs.go == 'true'
        run: |
          uv tool install 'streamsnow>=0.12.0,<0.13'
          uv tool install snowflake-cli

      # A repo can have deploy secrets before it has an app (`streamsnow init
      # --no-starter-app` writes no apps/ directory, and git cannot carry an
      # empty one). Copying a missing apps/ fails with "No data" (exit 2), and
      # an unmatched apps/*/ loops once over the literal pattern, so the deploy
      # and verify steps collect app directories with nullglob and stop cleanly
      # when there are none.
      #
      # The upload is a per-app bundle from `streamsnow stage-bundle`, not the
      # whole apps/ tree: it leaves out each app's AGENTS.md, REQUIREMENTS.md and
      # other root-level docs, sql_review/ and tooling folders, which the running
      # app never reads. `--recursive` skips dot-directories, so the loop after
      # the upload copies each bundled .streamlit/config.toml on its own.
      # Every producer runs before the first snow call, so a failed one stops the
      # step with Snowflake untouched.
      - name: Deploy changed apps (stage-copy)
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          shopt -s nullglob
          apps=(apps/*/)
          if [ "${#apps[@]}" -eq 0 ]; then
            echo "No app directories under apps/ yet: nothing to deploy."
            exit 0
          fi
          # One private directory holds every file this step writes, and per-app files
          # carry an app- prefix, so no app slug (objects, setup) can name the same file
          # as the app-data or setup SQL.
          work="$(mktemp -d "${RUNNER_TEMP:-/tmp}/ss-deploy.XXXXXX")"
          # Every file this step runs is written first, each producer on a line of its
          # own (under `set -e` a failure on the left of `&&` does not stop the script),
          # so any producer failure stops the step before Snowflake is touched. App data
          # (#79) is every view and dynamic table the apps declare in governance.app_data,
          # in dependency order; objects-sql checks every file and prints nothing at all
          # on any finding.
          streamsnow objects-sql > "$work/objects.sql"
          STAGE="$(streamsnow stage-path)"
          streamsnow deploy-setup > "$work/setup.sql"
          BUNDLE="${RUNNER_TEMP:-/tmp}/ss-bundle"
          rm -rf "$BUNDLE"
          streamsnow stage-bundle --out "$BUNDLE"
          for d in "${apps[@]}"; do
            slug="$(basename "$d")"
            streamsnow deploy-sql "$slug" --sha "$GITHUB_SHA" > "$work/app-$slug.sql"
          done
          # Snowflake from here on: setup, app data, then the apps.
          snow sql --temporary-connection -f "$work/setup.sql"
          if [ -s "$work/objects.sql" ]; then
            snow sql --temporary-connection -f "$work/objects.sql"
          fi
          snow stage copy --temporary-connection "$BUNDLE/" "$STAGE/commits/$GITHUB_SHA/apps/" --recursive --overwrite
          for d in "${apps[@]}"; do
            cfg="$BUNDLE/$(basename "$d")/.streamlit/config.toml"
            [ -f "$cfg" ] && snow stage copy --temporary-connection "$cfg" "$STAGE/commits/$GITHUB_SHA/apps/$(basename "$d")/.streamlit/" --overwrite
          done
          for d in "${apps[@]}"; do
            snow sql --temporary-connection -f "$work/app-$(basename "$d").sql"
          done

      # A CREATE OR REPLACE pipeline has no delete path — this is it. Every
      # identifier in deploy/tombstones.yml is dropped on every deploy
      # (IF EXISTS, so re-runs are no-ops). The PR check `streamsnow check
      # tombstones` is what guarantees the registry is complete; a malformed
      # registry makes --drop-sql exit 2 and fails this step before any DROP.
      - name: Reconcile tombstones (drop retired objects)
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          streamsnow check tombstones --drop-sql > /tmp/ss-drops.sql
          if [ -s /tmp/ss-drops.sql ]; then
            snow sql --temporary-connection -f /tmp/ss-drops.sql
          fi

      # "Deploy succeeded" is not "app serves": a missing live version renders
      # nothing in Snowsight, a stale version-source URI serves old code, and a
      # container app can crash-loop while its service reports healthy.
      - name: Verify deploy health
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          shopt -s nullglob
          apps=(apps/*/)
          if [ "${#apps[@]}" -eq 0 ]; then
            echo "No app directories under apps/ yet: nothing to verify."
            exit 0
          fi
          for d in "${apps[@]}"; do
            streamsnow verify-deploy "$(basename "$d")" --sha "$GITHUB_SHA" --temporary-connection
          done
{% endraw %}