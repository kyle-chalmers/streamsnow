{% raw %}# Deploy to Snowflake on merge to main (generated by StreamSnow — git-repository).
# EXPERIMENTAL source: Snowflake must reach GitHub (snow git fetch) or you mint a
# GitHub-App token into your secret. Run `streamsnow deploy-setup` once to create
# the API integration + secret + GIT REPOSITORY. Same SNOWFLAKE_* repo secrets as
# stage-copy; until SNOWFLAKE_ACCOUNT is set this job skips.
name: deploy

on:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: deploy-snowflake
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      SNOWFLAKE_ACCOUNT: ${{ secrets.SNOWFLAKE_ACCOUNT }}
      SNOWFLAKE_USER: ${{ secrets.SNOWFLAKE_USER }}
      SNOWFLAKE_AUTHENTICATOR: SNOWFLAKE_JWT
      SNOWFLAKE_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_PRIVATE_KEY_RAW }}
      SNOWFLAKE_PRIVATE_KEY_PASSPHRASE: ${{ secrets.SNOWFLAKE_PRIVATE_KEY_PASSPHRASE }}
      SNOWFLAKE_WAREHOUSE: ${{ secrets.SNOWFLAKE_WAREHOUSE }}
      SNOWFLAKE_ROLE: ${{ secrets.SNOWFLAKE_ROLE }}
    steps:
      - uses: actions/checkout@v4

      - name: Gate on configured secrets
        id: gate
        run: |
          if [ -z "$SNOWFLAKE_ACCOUNT" ]; then
            echo "Deploy secrets not set — skipping (see docs/deploy-setup.md)."
            echo "go=false" >> "$GITHUB_OUTPUT"
          else
            echo "go=true" >> "$GITHUB_OUTPUT"
          fi

      - uses: astral-sh/setup-uv@v5
        if: steps.gate.outputs.go == 'true'

      - name: Install tooling
        if: steps.gate.outputs.go == 'true'
        run: |
          uv tool install 'streamsnow>=0.6,<0.7'
          uv tool install snowflake-cli-labs

      - name: Deploy changed apps (git-repository)
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          REPO="$(streamsnow config-get deploy.git_repository_fqn)"
          snow git fetch "$REPO"
          for d in apps/*/; do
            [ -d "$d" ] || continue
            slug="$(basename "$d")"
            streamsnow deploy-sql "$slug" > "/tmp/ss-$slug.sql"
            snow sql -f "/tmp/ss-$slug.sql"
            streamsnow deploy-sql "$slug" --refresh > "/tmp/ss-$slug-refresh.sql"
            snow sql -f "/tmp/ss-$slug-refresh.sql" || true
          done

      # A CREATE OR REPLACE pipeline has no delete path — this is it. Every
      # identifier in deploy/tombstones.yml is dropped on every deploy
      # (IF EXISTS, so re-runs are no-ops). The PR check guarantees the
      # registry is complete; a malformed registry exits 2 before any DROP.
      - name: Reconcile tombstones (drop retired objects)
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          streamsnow check tombstones --drop-sql > /tmp/ss-drops.sql
          if [ -s /tmp/ss-drops.sql ]; then
            snow sql -f /tmp/ss-drops.sql
          fi

      # "Deploy succeeded" is not "app serves": a missing live version renders
      # nothing in Snowsight, and a container app can crash-loop while its
      # service reports healthy. (No --sha here: the git source pins freshness
      # via fetch + PULL, not a SHA-versioned stage path.)
      - name: Verify deploy health
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          for d in apps/*/; do
            [ -d "$d" ] || continue
            streamsnow verify-deploy "$(basename "$d")"
          done
{% endraw %}