{% raw %}# Deploy to Snowflake on merge to main (generated by StreamSnow — git-repository).
# Snowflake pulls the app source from GitHub (snow git fetch), so it must be able
# to reach github.com. Run `streamsnow deploy-setup --admin` once to create the API
# integration, the GIT REPOSITORY and (private repos) the token secret; see
# docs/git-repository.md. Same SNOWFLAKE_* repo secrets as stage-copy; until
# SNOWFLAKE_ACCOUNT is set this job skips.
name: deploy

on:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: deploy-snowflake
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      SNOWFLAKE_ACCOUNT: ${{ secrets.SNOWFLAKE_ACCOUNT }}
      SNOWFLAKE_USER: ${{ secrets.SNOWFLAKE_USER }}
      SNOWFLAKE_AUTHENTICATOR: SNOWFLAKE_JWT
      SNOWFLAKE_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_PRIVATE_KEY_RAW }}
      # snow reads an encrypted key's passphrase from PRIVATE_KEY_PASSPHRASE
      # (no SNOWFLAKE_ prefix); unused when the key is unencrypted.
      PRIVATE_KEY_PASSPHRASE: ${{ secrets.SNOWFLAKE_PRIVATE_KEY_PASSPHRASE }}
      SNOWFLAKE_WAREHOUSE: ${{ secrets.SNOWFLAKE_WAREHOUSE }}
      SNOWFLAKE_ROLE: ${{ secrets.SNOWFLAKE_ROLE }}
    # Every snow call (and verify-deploy) passes --temporary-connection: the
    # runner has no config.toml, so without it the Snowflake CLI looks for a
    # connection named "default" and fails ("Connection default is not
    # configured") instead of connecting from the SNOWFLAKE_* variables above
    # (https://docs.snowflake.com/en/developer-guide/snowflake-cli/connecting/configure-connections#use-a-temporary-connection).
    steps:
      - uses: actions/checkout@v4

      - name: Gate on configured secrets
        id: gate
        run: |
          if [ -z "$SNOWFLAKE_ACCOUNT" ]; then
            echo "Deploy secrets not set — skipping (see https://github.com/kyle-chalmers/streamsnow/blob/main/docs/deploy-setup.md)."
            echo "go=false" >> "$GITHUB_OUTPUT"
          else
            echo "Deploy secrets found: deploying."
            echo "go=true" >> "$GITHUB_OUTPUT"
          fi

      - uses: astral-sh/setup-uv@v5
        if: steps.gate.outputs.go == 'true'

      - name: Install tooling
        if: steps.gate.outputs.go == 'true'
        run: |
          uv tool install 'streamsnow>=0.10.1,<0.11'
          uv tool install snowflake-cli

      # A repo can have deploy secrets before it has an app (`streamsnow init
      # --no-starter-app` writes no apps/ directory, and git cannot carry an
      # empty one), so the deploy and verify steps collect app directories with
      # nullglob (an unmatched apps/*/ would otherwise loop once over the
      # literal pattern) and stop cleanly when there are none.
      - name: Deploy changed apps (git-repository)
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          shopt -s nullglob
          apps=(apps/*/)
          if [ "${#apps[@]}" -eq 0 ]; then
            echo "No app directories under apps/ yet: nothing to deploy."
            exit 0
          fi
          # One private directory holds every file this step writes, and per-app files
          # carry an app- prefix, so no app slug (objects, setup) can name the same file
          # as the app-data or setup SQL.
          work="$(mktemp -d "${RUNNER_TEMP:-/tmp}/ss-deploy.XXXXXX")"
          # Every file this step runs is written first, each producer on a line of its
          # own, so any producer failure stops the step before Snowflake is touched.
          # objects-sql (#79) checks every app-data file and prints nothing at all on
          # any finding.
          REPO="$(streamsnow config-get deploy.git_repository_fqn)"
          streamsnow objects-sql > "$work/objects.sql"
          for d in "${apps[@]}"; do
            slug="$(basename "$d")"
            streamsnow deploy-sql "$slug" > "$work/app-$slug.sql"
          done
          # A failed fetch stops the deploy: without it Snowflake would rebuild
          # each app from the previous commit and report success.
          snow git fetch --temporary-connection "$REPO"
          # The apps are built from the fetched branch, the app data from this
          # checkout. If another merge moved the branch after this run started,
          # they would come from different commits: stop before any DDL or app
          # change. The newer commit's own deploy run ships both.
          streamsnow git-head --expect "$GITHUB_SHA" --temporary-connection
          if [ -s "$work/objects.sql" ]; then
            snow sql --temporary-connection -f "$work/objects.sql"
          fi
          for d in "${apps[@]}"; do
            snow sql --temporary-connection -f "$work/app-$(basename "$d").sql"
          done

      # A CREATE OR REPLACE pipeline has no delete path — this is it. Every
      # identifier in deploy/tombstones.yml is dropped on every deploy
      # (IF EXISTS, so re-runs are no-ops). The PR check guarantees the
      # registry is complete; a malformed registry exits 2 before any DROP.
      - name: Reconcile tombstones (drop retired objects)
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          streamsnow check tombstones --drop-sql > /tmp/ss-drops.sql
          if [ -s /tmp/ss-drops.sql ]; then
            snow sql --temporary-connection -f /tmp/ss-drops.sql
          fi

      # "Deploy succeeded" is not "app serves": a missing live version renders
      # nothing in Snowsight, a live version built from an older commit serves
      # old code (--sha compares DESCRIBE's last_version_git_commit_hash), and a
      # container app can crash-loop while its service reports healthy.
      - name: Verify deploy health
        if: steps.gate.outputs.go == 'true'
        run: |
          set -euo pipefail
          shopt -s nullglob
          apps=(apps/*/)
          if [ "${#apps[@]}" -eq 0 ]; then
            echo "No app directories under apps/ yet: nothing to verify."
            exit 0
          fi
          for d in "${apps[@]}"; do
            streamsnow verify-deploy "$(basename "$d")" --sha "$GITHUB_SHA" --temporary-connection
          done
{% endraw %}