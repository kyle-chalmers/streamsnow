# sqlfluff settings for this repo's SQL (StreamSnow).
#
# `streamsnow sql-review generate` applies the layout and capitalisation fixes
# from these settings to every page section it writes, and
# `streamsnow sql-review check` lints each app's queries/*.sql with the full
# rule set below. Run the same lint by hand with:
#   sqlfluff lint apps/<slug>/queries --templater placeholder
#
# Tune it here (for example, add rule codes to exclude_rules); StreamSnow reads
# this file and never overwrites it. Keep it in the repo root.

[sqlfluff]
dialect = snowflake
templater = raw
rules = core
# CP02 would re-case identifiers; table and column names stay as written.
exclude_rules = CP02
max_line_length = 100

[sqlfluff:templater:placeholder]
param_style = colon

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
